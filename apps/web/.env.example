# Console web — quickstart .env template.
#
# Copy to .env when the Console server is on a different host than the
# web app (e.g. behind a reverse proxy). Otherwise the defaults read
# from window.location are usually right.
#
#   cp .env.example .env
#
# Note: every HTTP route is mounted under /api on the Console server,
# so the base URL must include /api. The WS endpoint stays at /ws —
# VITE_WS_URL is separate from the REST base.

VITE_CONSOLE_BASE_URL=http://localhost:8090/api
VITE_WS_URL=ws://localhost:8090/ws
