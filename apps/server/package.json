{
  "name": "@eveys-console/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --include .env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mint-token": "node scripts/mint-dev-token.mjs",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@eveys-console/api-types": "workspace:*",
    "@eveys-console/protocol": "workspace:*",
    "@fastify/cors": "10.0.2",
    "@fastify/jwt": "9.0.2",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/sensible": "6.0.2",
    "@fastify/websocket": "11.0.1",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "12.11.1",
    "fastify": "5.2.1",
    "kafkajs": "2.2.4",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "prom-client": "^15",
    "protobufjs": "7.4.0",
    "undici": "6.21.1",
    "yaml": "^2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.17.10",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
