# Console server — quickstart .env template.
#
# Copy to .env and fill in your secrets:
#     cp .env.example .env
#
# Generate a random JWT secret: `openssl rand -base64 48`
# Generate a random gateway token: `openssl rand -hex 32`
# (the same gateway token must appear in the gateway's
#  EVEYS_OCPP_REST_INBOUND_TOKENS allowlist)

# ---- HTTP / WS bind --------------------------------------------------
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info
LOG_PRETTY=true

# ---- JWT (HS256 for local dev — switch to RS256 + JWKS in prod) ------
JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_AUDIENCE=eveys-console
JWT_ISSUER=eveys-console
JWT_TTL_SECONDS=28800

# ---- Console login ---------------------------------------------------
# Plaintext credentials hashed at boot with bcrypt cost 10. Convenient
# for laptop dev — CHANGE the password on any shared host. Both must
# be set together (or both empty to fall back to CONSOLE_USERS).
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=admin

# Advanced: CSV of `username:bcrypthash` pairs (cost >= 10). When the
# same username appears in both CONSOLE_USERS and CONSOLE_USERNAME, the
# plaintext pair above wins. Hash with:
#   pnpm --filter @eveys-console/server hash-password
CONSOLE_USERS=

# ---- Login hardening -------------------------------------------------
# Anti-robot proof-of-work CAPTCHA. 16 ~= 50 ms; 20 ~= 1 s on a laptop.
AUTH_POW_DIFFICULTY=16
AUTH_POW_TTL_SECONDS=120

# Login attempts per IP per minute.
AUTH_LOGIN_MAX_PER_MIN=5

# Comma-separated allowed Origin headers. Empty disables the Origin
# check (acceptable for local dev). Production should list your web
# origin explicitly: e.g. https://console.example.com
ALLOWED_ORIGINS=http://localhost:5180

# ---- Gateway upstream ------------------------------------------------
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_TOKEN=replace-with-openssl-rand-hex-32

# ---- Kafka tail (live device-events feed on /sys/fleet/events) -------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eveys-console
KAFKA_GROUP_ID=eveys-console
KAFKA_TOPICS_BOOT=cp.boot
KAFKA_TOPICS_STATUS=cp.status
KAFKA_TOPICS_METER=cp.meter
KAFKA_TOPICS_TX_STARTED=tx.started
# Adding the presence topics keeps the live online flag accurate without
# waiting for the next boot / status event.
KAFKA_TOPICS_CONNECTED=cp.connected
KAFKA_TOPICS_DISCONNECTED=cp.disconnected

# ---- WS hardening ----------------------------------------------------
WS_MAX_SUBSCRIPTIONS_PER_CONN=50
WS_PING_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=120000

# ---- Alertmanager + Prometheus (optional; observability profile) -----
# Unset -> the corresponding /sys/alerts tab renders its "not configured"
# hint instead of an error toast. The defaults match the host-port
# mappings from the compose --profile observability stack.
# ALERTMANAGER_URL=http://localhost:9093
# PROMETHEUS_URL=http://localhost:9091
#
# Console-managed Alertmanager config (shared with the Alertmanager
# container as a writable volume). The Channels tab writes through this.
# ALERTMANAGER_CONFIG_PATH=./data/alertmanager-managed.yml

# ---- Production safety -----------------------------------------------
# Uncomment on production hosts. scripts/update.sh treats this as a
# warning gate (it never tears containers down); pass FORCE_PROD=1 on
# the invocation to silence the prompt.
# EVEYS_ENV=production
