# Console server configuration. Copy to .env, fill the secrets.

# HTTP / WS bind
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info
LOG_PRETTY=true

# JWT (HS256 for local dev — switch to RS256 + JWKS in production)
# Generate a secret: `openssl rand -base64 48`
JWT_SECRET=replace-me-with-a-real-secret-of-at-least-16-bytes
JWT_AUDIENCE=eveys-console
JWT_ISSUER=eveys-console
JWT_TTL_SECONDS=28800

# Console login. Plaintext credentials — hashed at boot with bcrypt cost
# 10. Convenient for laptop dev; change CONSOLE_PASSWORD to whatever you
# want. Both must be set together (or both empty).
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=admin

# Advanced: CSV of `username:bcrypthash` pairs. Empty disables this path.
# When the same username appears in both CONSOLE_USERS and
# CONSOLE_USERNAME, the plaintext pair above wins.
# Hash a password with `pnpm --filter @eveys-console/server hash-password`.
CONSOLE_USERS=

# Anti-robot proof-of-work CAPTCHA. 16 ≈ 50 ms; 20 ≈ 1 s on a laptop.
AUTH_POW_DIFFICULTY=16
AUTH_POW_TTL_SECONDS=120

# Login attempts per IP per minute.
AUTH_LOGIN_MAX_PER_MIN=5

# Comma-separated allowed Origin headers. Empty = no Origin check (dev).
ALLOWED_ORIGINS=

# Gateway upstream
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_TOKEN=dev-token

# Alertmanager + Prometheus (both optional; observability profile).
# Unset → the corresponding /sys/alerts tab renders its "not configured"
# hint instead of an error toast. When the compose --profile observability
# stack is up, the host-port mappings below work for local dev.
# ALERTMANAGER_URL=http://localhost:9093
# PROMETHEUS_URL=http://localhost:9091
#
# The Console-managed Alertmanager config lives here (shared with the
# Alertmanager container as a writable volume in compose). The Channels
# tab on /sys/alerts writes through this path.
# ALERTMANAGER_CONFIG_PATH=./data/alertmanager-managed.yml

# Kafka tail
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eveys-console
KAFKA_GROUP_ID=eveys-console
KAFKA_TOPICS_BOOT=cp.boot
KAFKA_TOPICS_STATUS=cp.status
KAFKA_TOPICS_METER=cp.meter
KAFKA_TOPICS_TX_STARTED=tx.started

# WS hardening
WS_MAX_SUBSCRIPTIONS_PER_CONN=50
WS_PING_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=120000
